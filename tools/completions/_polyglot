#compdef polyglot

_polyglot() {
    local -a subcommands
    subcommands=(
        "run:Compile and execute a file"
        "build:Compile a file"
        "check:Parse, translate, and check termination"
        "lsp:Run the language server over stdio"
        "exec:Compile and execute with machine-readable metrics"
        "visualizer:Serve the interactive AST/monomorphization visualizer"
        "gui:Alias for visualizer"
        "compile:Compatibility compile command"
    )

    _arguments -C \
        "1: :->cmd" \
        "*:: :->args"

    case $state in
        cmd)
            _describe "subcommand" subcommands
            ;;
        args)
            case $words[1] in
                run|build|check|exec)
                    _files -g "*.poly"
                    ;;
                visualizer|gui)
                    _arguments "--host[Interface to bind]:host" \
                               "--port[Port to bind]:port" \
                               "--no-open[Do not open a browser]" \
                               "--verbose[Log HTTP requests]"
                    ;;
                compile)
                    _arguments "--backend[Backend]:backend:(python native wasm jit)" \
                               "--stdin[Read from stdin]" \
                               "--file[Input file]:file:_files" \
                               "--trusted[Trusted mode]" \
                               "--verbose[Verbose errors]"
                    ;;
            esac
            ;;
    esac
}

_polyglot "$@"
