// std:math — integer and floating-point helpers.

#[terminates]
fn abs_i64(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn clamp_i64(x: i64, low: i64, high: i64) -> i64 {
    if x < low { return low; }
    if x > high { return high; }
    x
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = if a < 0 { -a } else { a };
    let mut y = if b < 0 { -b } else { b };
    while y != 0 {
        let next = x % y;
        x = y;
        y = next;
    }
    x
}

fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 { return 0; }
    let divisor = gcd(a, b);
    let quotient = a / divisor;
    ((quotient as i128) * (b as i128)) as i64
}

fn pow_mod(base: i64, exponent: i64, modulus: i64) -> i64 {
    if modulus == 0 { return 0; }
    let m = abs_i64(modulus);
    let mut factor = base % m;
    if factor < 0 { factor = factor + m; }
    let mut e = exponent;
    let mut result = 1 % m;
    while e > 0 {
        if e % 2 == 1 {
            let product = (result as i128) * (factor as i128);
            result = (product % (m as i128)) as i64;
        }
        e = e / 2;
        let square = (factor as i128) * (factor as i128);
        factor = (square % (m as i128)) as i64;
    }
    result
}

fn is_prime(n: i64) -> bool {
    if n < 2 { return false; }
    if n % 2 == 0 { return n == 2; }
    let mut d = 3;
    while d <= n / d {
        if n % d == 0 { return false; }
        d = d + 2;
    }
    true
}

fn sqrt_f64(x: f64) -> Result<f64, String> {
    if x < 0.0 { return Err("sqrt of a negative number".to_string()); }
    if x == 0.0 { return Ok(0.0); }
    let mut guess = x;
    if guess < 1.0 { guess = 1.0; }
    let mut iteration = 0;
    while iteration < 100 {
        let next = 0.5 * (guess + x / guess);
        let delta = next - guess;
        let size = abs_f64(delta);
        guess = next;
        if size < 1e-12 { break; }
        iteration = iteration + 1;
    }
    Ok(guess)
}

fn exp_f64(x: f64) -> f64 {
    let mut scaled = x;
    let mut squarings = 0;
    while scaled > 0.5 {
        scaled = scaled / 2.0;
        squarings = squarings + 1;
    }
    while scaled < -0.5 {
        scaled = scaled / 2.0;
        squarings = squarings + 1;
    }
    let mut term = 1.0;
    let mut total = 1.0;
    let mut i = 1;
    while i <= 30 {
        term = term * scaled / (i as f64);
        total = total + term;
        i = i + 1;
    }
    let mut j = 0;
    while j < squarings {
        total = total * total;
        j = j + 1;
    }
    total
}
