// std:algo — sorting, searching, and small sequence helpers.
//
// All functions are pure: they take a vector, work on a clone, and return a
// new vector. Callers keep ownership of their input.

fn bubble_sort(values: Vec<i64>) -> Vec<i64> {
    let mut out = values.clone();
    let n = out.len();
    if n < 2 { return out; }
    let mut i = 0;
    while i < n {
        let mut j = 0;
        while j + 1 < n - i {
            if out[j] > out[j + 1] {
                let tmp = out[j];
                out[j] = out[j + 1];
                out[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    out
}

fn insertion_sort(values: Vec<i64>) -> Vec<i64> {
    let mut out = values.clone();
    let n = out.len();
    let mut i = 1;
    while i < n {
        let key = out[i];
        let mut j = i;
        while j > 0 && out[j - 1] > key {
            out[j] = out[j - 1];
            j = j - 1;
        }
        out[j] = key;
        i = i + 1;
    }
    out
}

fn selection_sort(values: Vec<i64>) -> Vec<i64> {
    let mut out = values.clone();
    let n = out.len();
    let mut i = 0;
    while i < n {
        let mut best = i;
        let mut j = i + 1;
        while j < n {
            if out[j] < out[best] { best = j; }
            j = j + 1;
        }
        if best != i {
            let tmp = out[i];
            out[i] = out[best];
            out[best] = tmp;
        }
        i = i + 1;
    }
    out
}

fn binary_search(values: Vec<i64>, target: i64) -> Option<usize> {
    let mut low = 0;
    let mut high = values.len();
    while low < high {
        let mid = low + (high - low) / 2;
        if values[mid] == target { return Some(mid); }
        if values[mid] < target { low = mid + 1; } else { high = mid; }
    }
    None
}

fn linear_search(values: Vec<i64>, target: i64) -> Option<usize> {
    let mut i = 0;
    while i < values.len() {
        if values[i] == target { return Some(i); }
        i = i + 1;
    }
    None
}

fn is_sorted(values: Vec<i64>) -> bool {
    let mut i = 1;
    while i < values.len() {
        if values[i - 1] > values[i] { return false; }
        i = i + 1;
    }
    true
}

fn sum(values: Vec<i64>) -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i < values.len() {
        total = total + values[i];
        i = i + 1;
    }
    total
}

fn max_value(values: Vec<i64>) -> Option<i64> {
    if values.is_empty() { return None; }
    let mut best = values[0];
    let mut i = 1;
    while i < values.len() {
        if values[i] > best { best = values[i]; }
        i = i + 1;
    }
    Some(best)
}

fn min_value(values: Vec<i64>) -> Option<i64> {
    if values.is_empty() { return None; }
    let mut best = values[0];
    let mut i = 1;
    while i < values.len() {
        if values[i] < best { best = values[i]; }
        i = i + 1;
    }
    Some(best)
}

fn reverse_values(values: Vec<i64>) -> Vec<i64> {
    let mut out = values.clone();
    out.reverse();
    out
}

// Sorted unique elements; duplicates collapse.
fn unique(values: Vec<i64>) -> Vec<i64> {
    let mut out = values.clone();
    out.sort();
    out.dedup();
    out
}

fn count_occurrences(values: Vec<i64>, target: i64) -> i64 {
    let mut count = 0;
    let mut i = 0;
    while i < values.len() {
        if values[i] == target { count = count + 1; }
        i = i + 1;
    }
    count
}

// Sum each non-overlapping window of `size` elements; a zero size yields [].
fn chunk_sum(values: Vec<i64>, size: usize) -> Vec<i64> {
    if size == 0 { return [].to_vec(); }
    let chunks = values.chunks(size);
    let mut out: Vec<i64> = [].to_vec();
    let mut i = 0;
    while i < chunks.len() {
        out.push(sum(chunks[i].clone()));
        i = i + 1;
    }
    out
}

// Prefix maxima: result[i] is the largest value in values[0..=i].
fn running_max(values: Vec<i64>) -> Vec<i64> {
    let mut out: Vec<i64> = [].to_vec();
    if values.is_empty() { return out; }
    let mut best = values[0];
    let mut i = 0;
    while i < values.len() {
        if values[i] > best { best = values[i]; }
        out.push(best);
        i = i + 1;
    }
    out
}

fn find_index(values: Vec<i64>, target: i64) -> Option<i64> {
    let mut i = 0;
    while i < values.len() {
        if values[i] == target { return Some(i as i64); }
        i = i + 1;
    }
    None
}

fn all_equal(values: Vec<i64>) -> bool {
    if values.len() < 2 { return true; }
    let mut i = 1;
    while i < values.len() {
        if values[i] != values[0] { return false; }
        i = i + 1;
    }
    true
}

// Rotate left by `k`, wrapping with a modulo so large k stays in range.
fn rotate_left(values: Vec<i64>, k: usize) -> Vec<i64> {
    let mut out = values.clone();
    if out.is_empty() { return out; }
    let amount = k % out.len();
    out.rotate_left(amount);
    out
}

// Element-wise sums, truncated to the shorter input.
fn zip_sum(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    let mut out: Vec<i64> = [].to_vec();
    let mut i = 0;
    while i < n {
        out.push(a[i] + b[i]);
        i = i + 1;
    }
    out
}
