// std:numpy — a tiny dense 2-D array type in pure .poly.
//
// `NdArray` stores a row-major `Vec<f64>` plus its shape. The API stays inside
// the language subset so it behaves identically on both backends.

include!("std:math");

#[derive(Clone)]
struct NdArray {
    data: Vec<f64>,
    rows: usize,
    cols: usize,
}

impl NdArray {
    fn zeros(rows: usize, cols: usize) -> NdArray {
        let mut data: Vec<f64> = [].to_vec();
        let total = rows * cols;
        let mut i = 0;
        while i < total {
            data.push(0.0);
            i = i + 1;
        }
        NdArray { data: data, rows: rows, cols: cols }
    }

    fn ones(rows: usize, cols: usize) -> NdArray {
        let mut out = NdArray::zeros(rows, cols);
        out.fill(1.0);
        out
    }

    fn full(rows: usize, cols: usize, value: f64) -> NdArray {
        let mut out = NdArray::zeros(rows, cols);
        out.fill(value);
        out
    }

    fn eye(n: usize) -> NdArray {
        let mut out = NdArray::zeros(n, n);
        let mut i = 0;
        while i < n {
            out.set(i, i, 1.0);
            i = i + 1;
        }
        out
    }

    fn from_vec(values: Vec<f64>, rows: usize, cols: usize) -> Result<NdArray, String> {
        if values.len() != rows * cols {
            return Err("from_vec: data length does not match shape".to_string());
        }
        Ok(NdArray { data: values, rows: rows, cols: cols })
    }

    fn from_slice(values: Vec<f64>) -> NdArray {
        let n = values.len();
        NdArray { data: values, rows: 1, cols: n }
    }

    fn shape(&self) -> Vec<usize> {
        [self.rows, self.cols].to_vec()
    }

    fn nrows(&self) -> usize {
        self.rows
    }

    fn ncols(&self) -> usize {
        self.cols
    }

    fn size(&self) -> usize {
        self.data.len()
    }

    fn is_empty(&self) -> bool {
        self.data.is_empty()
    }

    fn to_vec(&self) -> Vec<f64> {
        self.data.clone()
    }

    fn fill(&mut self, value: f64) {
        let mut i = 0;
        while i < self.data.len() {
            self.data[i] = value;
            i = i + 1;
        }
    }

    fn get(&self, row: usize, col: usize) -> Option<f64> {
        if row >= self.rows || col >= self.cols { return None; }
        Some(self.data[row * self.cols + col])
    }

    fn at(&self, row: usize, col: usize) -> f64 {
        self.data[row * self.cols + col]
    }

    fn set(&mut self, row: usize, col: usize, value: f64) -> bool {
        if row >= self.rows || col >= self.cols { return false; }
        self.data[row * self.cols + col] = value;
        true
    }

    fn row(&self, index: usize) -> Result<Vec<f64>, String> {
        if index >= self.rows { return Err("row index out of bounds".to_string()); }
        let mut out: Vec<f64> = [].to_vec();
        let mut j = 0;
        while j < self.cols {
            out.push(self.at(index, j));
            j = j + 1;
        }
        Ok(out)
    }

    fn col(&self, index: usize) -> Result<Vec<f64>, String> {
        if index >= self.cols { return Err("column index out of bounds".to_string()); }
        let mut out: Vec<f64> = [].to_vec();
        let mut i = 0;
        while i < self.rows {
            out.push(self.at(i, index));
            i = i + 1;
        }
        Ok(out)
    }

    fn reshape(&self, rows: usize, cols: usize) -> Result<NdArray, String> {
        NdArray::from_vec(self.data.clone(), rows, cols)
    }

    fn transpose(&self) -> NdArray {
        let mut out = NdArray::zeros(self.cols, self.rows);
        let mut i = 0;
        while i < self.rows {
            let mut j = 0;
            while j < self.cols {
                out.set(j, i, self.at(i, j));
                j = j + 1;
            }
            i = i + 1;
        }
        out
    }

    fn add(&self, other: &NdArray) -> Result<NdArray, String> {
        if self.rows != other.rows || self.cols != other.cols {
            return Err("add: shape mismatch".to_string());
        }
        let mut out = NdArray::zeros(self.rows, self.cols);
        let mut i = 0;
        while i < self.data.len() {
            out.data[i] = self.data[i] + other.data[i];
            i = i + 1;
        }
        Ok(out)
    }

    fn sub(&self, other: &NdArray) -> Result<NdArray, String> {
        if self.rows != other.rows || self.cols != other.cols {
            return Err("sub: shape mismatch".to_string());
        }
        let mut out = NdArray::zeros(self.rows, self.cols);
        let mut i = 0;
        while i < self.data.len() {
            out.data[i] = self.data[i] - other.data[i];
            i = i + 1;
        }
        Ok(out)
    }

    // Element-wise product (Hadamard), not a matrix product.
    fn mul(&self, other: &NdArray) -> Result<NdArray, String> {
        if self.rows != other.rows || self.cols != other.cols {
            return Err("mul: shape mismatch".to_string());
        }
        let mut out = NdArray::zeros(self.rows, self.cols);
        let mut i = 0;
        while i < self.data.len() {
            out.data[i] = self.data[i] * other.data[i];
            i = i + 1;
        }
        Ok(out)
    }

    fn scale(&self, factor: f64) -> NdArray {
        let mut out = self.clone();
        let mut i = 0;
        while i < out.data.len() {
            out.data[i] = out.data[i] * factor;
            i = i + 1;
        }
        out
    }

    fn add_scalar(&self, value: f64) -> NdArray {
        let mut out = self.clone();
        let mut i = 0;
        while i < out.data.len() {
            out.data[i] = out.data[i] + value;
            i = i + 1;
        }
        out
    }

    fn neg(&self) -> NdArray {
        self.scale(-1.0)
    }

    fn abs(&self) -> NdArray {
        let mut out = self.clone();
        let mut i = 0;
        while i < out.data.len() {
            out.data[i] = abs_f64(out.data[i]);
            i = i + 1;
        }
        out
    }

    fn exp(&self) -> NdArray {
        let mut out = self.clone();
        let mut i = 0;
        while i < out.data.len() {
            out.data[i] = exp_f64(out.data[i]);
            i = i + 1;
        }
        out
    }

    fn sqrt(&self) -> Result<NdArray, String> {
        let mut out = self.clone();
        let mut i = 0;
        while i < out.data.len() {
            out.data[i] = sqrt_f64(out.data[i])?;
            i = i + 1;
        }
        Ok(out)
    }

    fn matmul(&self, other: &NdArray) -> Result<NdArray, String> {
        if self.cols != other.rows {
            return Err("matmul: inner dimensions do not match".to_string());
        }
        let mut out = NdArray::zeros(self.rows, other.cols);
        let mut i = 0;
        while i < self.rows {
            let mut j = 0;
            while j < other.cols {
                let mut total = 0.0;
                let mut k = 0;
                while k < self.cols {
                    total = total + self.at(i, k) * other.at(k, j);
                    k = k + 1;
                }
                out.set(i, j, total);
                j = j + 1;
            }
            i = i + 1;
        }
        Ok(out)
    }

    fn dot(&self, other: &NdArray) -> Result<NdArray, String> {
        self.matmul(other)
    }

    fn trace(&self) -> Result<f64, String> {
        if self.rows != self.cols {
            return Err("trace: matrix is not square".to_string());
        }
        let mut total = 0.0;
        let mut i = 0;
        while i < self.rows {
            total = total + self.at(i, i);
            i = i + 1;
        }
        Ok(total)
    }

    fn sum(&self) -> f64 {
        let mut total = 0.0;
        let mut i = 0;
        while i < self.data.len() {
            total = total + self.data[i];
            i = i + 1;
        }
        total
    }

    fn mean(&self) -> f64 {
        if self.data.is_empty() { return 0.0; }
        self.sum() / (self.data.len() as f64)
    }

    fn min(&self) -> Option<f64> {
        if self.data.is_empty() { return None; }
        let mut best = self.data[0];
        let mut i = 1;
        while i < self.data.len() {
            if self.data[i] < best { best = self.data[i]; }
            i = i + 1;
        }
        Some(best)
    }

    fn max(&self) -> Option<f64> {
        if self.data.is_empty() { return None; }
        let mut best = self.data[0];
        let mut i = 1;
        while i < self.data.len() {
            if self.data[i] > best { best = self.data[i]; }
            i = i + 1;
        }
        Some(best)
    }

    fn argmax(&self) -> Option<usize> {
        if self.data.is_empty() { return None; }
        let mut best = 0;
        let mut i = 1;
        while i < self.data.len() {
            if self.data[i] > self.data[best] { best = i; }
            i = i + 1;
        }
        Some(best)
    }

    fn argmin(&self) -> Option<usize> {
        if self.data.is_empty() { return None; }
        let mut best = 0;
        let mut i = 1;
        while i < self.data.len() {
            if self.data[i] < self.data[best] { best = i; }
            i = i + 1;
        }
        Some(best)
    }

    fn frobenius_norm(&self) -> f64 {
        let mut total = 0.0;
        let mut i = 0;
        while i < self.data.len() {
            total = total + self.data[i] * self.data[i];
            i = i + 1;
        }
        match sqrt_f64(total) {
            Ok(value) => value,
            Err(_) => 0.0,
        }
    }

    fn approx_eq(&self, other: &NdArray, tolerance: f64) -> bool {
        if self.rows != other.rows || self.cols != other.cols { return false; }
        let mut i = 0;
        while i < self.data.len() {
            if abs_f64(self.data[i] - other.data[i]) > tolerance { return false; }
            i = i + 1;
        }
        true
    }
}

fn zeros(rows: usize, cols: usize) -> NdArray {
    NdArray::zeros(rows, cols)
}

fn ones(rows: usize, cols: usize) -> NdArray {
    NdArray::ones(rows, cols)
}

fn full(rows: usize, cols: usize, value: f64) -> NdArray {
    NdArray::full(rows, cols, value)
}

fn eye(n: usize) -> NdArray {
    NdArray::eye(n)
}

fn identity(n: usize) -> NdArray {
    NdArray::eye(n)
}

fn from_vec(values: Vec<f64>, rows: usize, cols: usize) -> Result<NdArray, String> {
    NdArray::from_vec(values, rows, cols)
}

fn from_slice(values: Vec<f64>) -> NdArray {
    NdArray::from_slice(values)
}
