// Zig-exclusive special functions (SPEC 8.12.15-8.12.22).
// Run with: polyglot run --backend zig examples/zig_intrinsics.poly
//
// These do not exist on the Python or native backends: every call lowers onto
// a Zig builtin or std.math helper (@popCount, @clz, @ctz, @byteSwap,
// @bitReverse, @bitCast, @bitSizeOf, @sizeOf, @alignOf, @addWithOverflow,
// @mulWithOverflow, @intFromFloat, @floatFromInt, @memcpy, @memset,
// std.math.rotl) and therefore belongs to the opt-in Zig execution mode.

#[packed]
struct FrameHeader {
    version: u3,
    flags: u5,
    compressed: bool,
}

fn header_bits() -> i64 {
    bitsizeof!(FrameHeader)
}

fn bit_density(x: u32) -> i64 {
    popcount!(x)
}

fn leading_zeros(x: u32) -> i64 {
    clz!(x)
}

fn swapped(x: u32) -> u32 {
    bswap!(x)
}

fn reversed_byte(x: u8) -> u8 {
    bitreverse!(x)
}

fn float_pattern(x: f32) -> u32 {
    bitcast!(x, u32)
}

fn rotate_left(x: u32, count: u32) -> u32 {
    rotl!(x, count)
}

fn add_overflow_flag(x: u8, y: u8) -> i64 {
    add_with_overflow!(x, y)
}

fn truncated(x: f64) -> i64 {
    int_from_float!(x)
}

fn header_alignment() -> i64 {
    alignof!(FrameHeader)
}

fn main() -> i64 {
    let pattern: u32 = float_pattern(1.0);
    if pattern != 0x3F800000 {
        return 1;
    }
    if header_bits() != 9 {
        return 2;
    }
    if bit_density(0b1011) != 3 {
        return 3;
    }
    if leading_zeros(1) != 31 {
        return 4;
    }
    if swapped(0x12345678) != 0x78563412 {
        return 5;
    }
    if reversed_byte(1) != 128 {
        return 6;
    }
    if rotate_left(0x12345678, 5) != 0x468ACF02 {
        return 7;
    }
    if add_overflow_flag(200, 100) != 1 {
        return 8;
    }
    if truncated(1.9) != 1 {
        return 9;
    }
    // A 9-bit packed struct is backed by a 2-byte integer, so alignment and
    // sizeof! agree even though sizeof! rounds up from 9 bits.
    if header_alignment() != 2 {
        return 10;
    }
    255
}
